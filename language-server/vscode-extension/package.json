{
   "name": "taxi-language-server",
   "publisher": "taxi-lang",
   "displayName": "taxi-language-server",
   "description": "Language server for Taxi",
   "repository": {
      "type": "git",
      "url": "https://gitlab.com/taxi-lang/language-server"
   },
   "version": "1.68.1",
   "engines": {
      "vscode": "^1.68.0"
   },
   "categories": [
      "Other"
   ],
   "activationEvents": [
      "onLanguage:taxi",
      "onLanguage:taxiql",
      "onLanguage:taxiql-stubs",
      "onNotebook:taxiql-notebook"
   ],
   "main": "./out/extension.js",
   "contributes": {
      "semanticTokenScopes": [
         {
            "language": "taxi",
            "scopes": {
               "entityName": [
                  "entity.name.taxi"
               ],
               "punctuation": [
                  "entity.name.taxi"
               ]
            }
         }
      ],
      "languages": [
         {
            "id": "taxi",
            "aliases": [
               "taxi"
            ],
            "extensions": [
               ".taxi"
            ],
            "configuration": "./language-configuration.json"
         },
         {
            "id": "taxiql",
            "aliases": [
               "TaxiQL"
            ]
         },
         {
            "id": "taxiql-stubs",
            "aliases": [
               "TaxiQL Stubs"
            ]
         }
      ],
      "grammars": [
         {
            "language": "taxi",
            "scopeName": "source.taxi",
            "path": "./syntaxes/taxi.tmLanguage.json"
         }
      ],
      "notebooks": [
         {
            "type": "taxiql-notebook",
            "displayName": "TaxiQL Notebook",
            "selector": [
               {
                  "filenamePattern": "*.taxiqnb"
               }
            ]
         }
      ],
      "notebookRenderer": [
         {
            "id": "taxiql-renderer",
            "displayName": "TaxiQL Renderer",
            "entrypoint": "./out/renderer/index.js",
            "mimeTypes": [
               "application/vnd.taxi.plan+json",
               "application/vnd.taxi.results+json",
               "application/vnd.taxi.queryplan+json"
            ]
         }
      ],
      "commands": [
         {
            "command": "taxiql.notebook.new",
            "title": "New TaxiQL Notebook",
            "category": "TaxiQL",
            "icon": "$(notebook)"
         },
         {
            "command": "taxiql.notebook.attachStubs",
            "title": "Attach Stubs...",
            "category": "TaxiQL",
            "icon": "$(server-process)"
         },
         {
            "command": "taxiql.notebook.changeStubs",
            "title": "Change Stubs...",
            "category": "TaxiQL"
         },
         {
            "command": "taxiql.notebook.clearStubs",
            "title": "Clear Stubs",
            "category": "TaxiQL"
         },
         {
            "command": "taxiql.notebook.showQueryPlan",
            "title": "Show Query Plan",
            "category": "TaxiQL",
            "icon": "$(type-hierarchy)"
         }
      ],
      "menus": {
         "file/newFile": [
            {
               "command": "taxiql.notebook.new",
               "group": "notebook"
            }
         ],
         "notebook/cell/title": [
            {
               "command": "taxiql.notebook.attachStubs",
               "when": "notebookType == taxiql-notebook && notebookCellType == code && !notebookCellMetadata.taxi.stubsId",
               "group": "inline"
            },
            {
               "command": "taxiql.notebook.changeStubs",
               "when": "notebookType == taxiql-notebook && notebookCellType == code && notebookCellMetadata.taxi.stubsId",
               "group": "inline"
            },
            {
               "command": "taxiql.notebook.showQueryPlan",
               "when": "notebookType == taxiql-notebook && notebookCellType == code",
               "group": "inline"
            },
            {
               "command": "taxiql.notebook.clearStubs",
               "when": "notebookType == taxiql-notebook && notebookCellType == code && notebookCellMetadata.taxi.stubsId"
            }
         ]
      },
      "configuration": {
         "type": "object",
         "title": "Taxi",
         "properties": {
            "taxi.typeChecker": {
               "type": "string",
               "default": "enabled",
               "enum": [
                  "enabled",
                  "disabled",
                  "soft_enabled"
               ],
               "enumDescriptions": [
                  "Enables the type checker.  Type violations are reported as errors",
                  "Disables the type checker.  Type vioaltions are not reported",
                  "Enables the type checker.  Type violations are reported as warnings"
               ]
            },
            "taxi.javaHome": {
               "type": "string",
               "default": "",
               "description": "Java Home dir - will try to autodetect if missing"
            }
         }
      }
   },
   "scripts": {
      "semantic-release": "semantic-release",
      "vscode:prepublish": "npm run sync-pom-version && npm run compile && cp ../taxi-lang-server-standalone/target/taxi-lang-server-jar-with-dependencies.jar out/",
      "compile": "tsc -p ./ && npm run compile:renderer",
      "compile:renderer": "node esbuild.renderer.js",
      "lint": "eslint src --ext ts",
      "watch": "tsc -watch -p ./",
      "pretest": "npm run compile && npm run lint",
      "test": "node ./out/test/runTest.js",
      "sync-pom-version": "sync-pom-version",
      "vsce:package": "vsce package",
      "vsce:publish": "vsce publish"
   },
   "dependencies": {
      "@heroicons/react": "^2.2.0",
      "@tabler/icons-react": "^3.36.1",
      "@vscode/codicons": "^0.0.44",
      "@xyflow/react": "^12.10.0",
      "ag-grid-community": "^35.0.1",
      "ag-grid-react": "^35.0.1",
      "elkjs": "^0.9.3",
      "find-java-home": "^1.1.0",
      "glob": "^7.1.6",
      "react": "^19.2.4",
      "react-dom": "^19.2.4",
      "react-json-tree": "^0.20.0",
      "vscode-languageclient": "^9.0.1",
      "ws": "^6.0.0"
   },
   "devDependencies": {
      "@semantic-release/changelog": "^5.0.1",
      "@semantic-release/exec": "^5.0.0",
      "@semantic-release/git": "9.0.1",
      "@semantic-release/gitlab-config": "^8.0.0",
      "@types/glob": "^7.1.1",
      "@types/mocha": "^7.0.2",
      "@types/node": "^13.11.0",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3",
      "@types/vscode": "^1.68.0",
      "@types/ws": "^6.0.0",
      "@typescript-eslint/eslint-plugin": "^2.26.0",
      "@typescript-eslint/parser": "^2.26.0",
      "esbuild": "^0.27.2",
      "eslint": "^6.8.0",
      "mocha": "^7.1.1",
      "semantic-release": "17.4.7",
      "semantic-release-vsce": "^3.0.1",
      "sync-pom-version-to-package": "^1.6.1",
      "typescript": "^4.9.5",
      "vsce": "2.11.0",
      "vscode-test": "^1.3.0",
      "vscode-tmgrammar-test": "^0.1.1"
   },
   "release": {
      "verifyConditions": [
         "semantic-release-vsce",
         "@semantic-release/gitlab"
      ],
      "generateNotes": "@semantic-release/release-notes-generator",
      "prepare": {
         "path": "semantic-release-vsce",
         "packageVsix": "taxi-language-server.vsix"
      },
      "publish": [
         "semantic-release-vsce",
         {
            "path": "@semantic-release/gitlab",
            "assets": "taxi-language-server.vsix"
         }
      ]
   }
}
