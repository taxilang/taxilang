import acme.fx.CurrencySymbol

namespace org.taxilang.semantics

type Symbol inherits String

type ConstWithNumber = 2

// This is a comment
model Trade {
    @Id
    symbol : CurrencySymbol inherits String
    baseCurrency : Symbol = "GBP"
}

enum Direction {
    Buy, Sell
}

@Format("yyyy-MM-dd'T'HH:mm:ssX")
type ModifiedSinceTime inherits Instant

service TradesApi {
    @HttpOperation(method = "GET", url = "http://trades.com/{symbol}")
    operation getTrades(symbol:Symbol):Trades
}
