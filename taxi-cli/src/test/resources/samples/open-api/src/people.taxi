model Person {
  firstName : FirstName inherits String
   id: PersonId inherits Int
}

@taxi.http.HttpService(baseUrl = "https://foo.com")
service PersonService {
   [[ Finds all the people. ]]
   @taxi.http.HttpOperation(method = "GET", url = "/people")
   operation findAllPeople():Person[]

   [[ Finds just one person.  Sometimes, that's all you need, y'know?  Just one person. ]]
   @taxi.http.HttpOperation(method = "GET", url = "/people/{id}")
   operation findPerson(@taxi.http.PathVariable("id") id: PersonId): Person

   [[ Updates a person. ]]
   @taxi.http.HttpOperation(method = "POST", url = "/people/{id}")
   operation updatePerson(@taxi.http.PathVariable("id") id: PersonId, @taxi.http.RequestBody update: Person): Person

   [[ Deletes the person.  BOOM! They're gone. ]]
   @taxi.http.HttpOperation(method = "DELETE", url = "/people/{id}")
   operation killPerson(
      [[ The id of the person to kill. Choose wisely ]]
      @taxi.http.PathVariable("id") id: PersonId?
      ): Person
}
