{
  "name": "taxiql-client",
  "projectType": "library",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "typescript/taxiql-client/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "typescript/taxiql-client",
        "command": "npm run build"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "typescript/taxiql-client",
        "command": "npm test"
      }
    }
  },
  "tags": ["typescript"]
}