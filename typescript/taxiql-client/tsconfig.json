{
   "extends": "../../tsconfig.base.json",
   "compilerOptions": {
      "outDir": "dist",
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "target": "ESNext",
      "lib": ["ESNext", "DOM"],
      "esModuleInterop": true,
      "declaration": true,
      "declarationMap": true,
      "allowSyntheticDefaultImports": true,
      "emitDeclarationOnly": true,
      "strict": true,
   },
   "include": ["src/**/*.ts", "src/**/*.tsx"]
}
