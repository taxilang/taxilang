{
   "compilerOptions": {
      "target": "es2020",
      "module": "ESNext",
      "moduleResolution": "NodeNext",
      "sourceMap": true,
      "outDir": "./dist",
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "strict": true,
      "skipLibCheck": true,
      "types": [
         "vitest/globals"
      ]
   }
}
